# Sentinel AI Environment Configuration

# Application
APP_NAME=Sentinel AI SOC
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Database (Supabase PostgreSQL URL or SQLite fallback)
# Example Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./sentinel.db

# Gemini AI API Key (Optional for Module 4)
GEMINI_API_KEY=your_gemini_api_key_here
